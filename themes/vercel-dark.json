{
  "$schema": "vscode://schemas/color-theme",
  "colors": {
    // Bar
    "titleBar.inactiveBackground": "#000000",
    "titleBar.activeBackground": "#000000",
    "titleBar.inactiveForeground": "#a1a1a1", // colors.secondary
    "titleBar.activeForeground": "#ededed",
    "titleBar.border": "#1f1f1f",
    "commandCenter.background": "#0a0a0a", // colors.background_comparison
    "commandCenter.activeBackground": "#1a1a1a", // colors.background_hover
    "commandCenter.debuggingBackground": "#00000000",
    "commandCenter.border": "#1f1f1f",
    "commandCenter.activeBorder": "#1f1f1f",
    "commandCenter.inactiveBorder": "#1f1f1f",
    "agentStatusIndicator.background": "#0a0a0a", // colors.background_comparison
    "sideBar.background": "#000000",
    "sideBar.foreground": "#ededed",
    "sideBar.border": "#000000", // colors.background
    "sideBarTitle.foreground": "#a1a1a1", // colors.secondary
    "sideBarSectionHeader.background": "#000000",
    "sideBarSectionHeader.foreground": "#a1a1a1", // colors.secondary
    "sideBarSectionHeader.border": "#1f1f1f",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#ededed",
    "activityBar.inactiveForeground": "#a1a1a1", // colors.secondary
    "activityBar.border": "#1f1f1f",
    "activityBar.activeBorder": "#52a8ff", // colors.border_focus
    "tree.indentGuidesStroke": "#1f1f1f", // colors.border
    "statusBar.background": "#000000",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#ededed", // colors.background_reverse
    "statusBar.foreground": "#a1a1a1", // colors.secondary
    "statusBar.debuggingForeground": "#0a0a0a", // colors.foreground_reverse
    "statusBar.border": "#1f1f1f",
    "statusBarItem.hoverBackground": "#1a1a1a", // colors.background_hover
    "statusBarItem.remoteBackground": "#ededed", // colors.background_reverse
    "statusBarItem.remoteHoverBackground": "#a1a1a1", // colors.background_reverse_hover
    "statusBarItem.remoteForeground": "#0a0a0a", // colors.foreground_reverse
    "statusBarItem.remoteHoverForeground": "#0a0a0a", // colors.foreground_reverse
    "statusBarItem.prominentBackground": "#000000",
    "statusBarItem.prominentHoverBackground": "#ededed", // colors.background_reverse
    "scrollbarSlider.background": "#878787", // colors.scrollbar_thumb
    "scrollbarSlider.hoverBackground": "#878787", // colors.scrollbar_thumb
    "scrollbarSlider.activeBackground": "#878787", // colors.scrollbar_thumb
    "progressBar.background": "#ededed", // colors.background_reverse

    // Popup
    "quickInput.background": "#0a0a0a", // colors.background_comparison
    "quickInput.foreground": "#ededed",
    "pickerGroup.border": "#1f1f1f",
    "pickerGroup.foreground": "#ededed",
    "debugToolBar.background": "#0a0a0a", // colors.background_comparison

    // Breadcrumb
    "breadcrumb.foreground": "#a1a1a1", // colors.secondary
    "breadcrumb.focusForeground": "#ededed",
    "breadcrumb.activeSelectionForeground": "#ededed",
    "breadcrumbPicker.background": "#0a0a0a", // colors.background_comparison

    // Badge
    "badge.background": "#ededed", // colors.background_reverse
    "badge.foreground": "#0a0a0a", // colors.foreground_reverse
    "activityBarBadge.background": "#ededed", // colors.background_reverse
    "activityBarBadge.foreground": "#0a0a0a", // colors.foreground_reverse

    // Controls
    "button.background": "#ededed", // colors.background_reverse
    "button.hoverBackground": "#a1a1a1", // colors.background_reverse_hover
    "button.foreground": "#0a0a0a", // colors.foreground_reverse
    "button.secondaryBackground": "#0a0a0a", // colors.background_comparison
    "button.secondaryHoverBackground": "#1a1a1a", // colors.background_hover
    "button.secondaryForeground": "#ededed",
    "checkbox.background": "#0a0a0a", // colors.background_comparison
    "checkbox.disabled.background": "#1a1a1a", // colors.background_disable
    "checkbox.foreground": "#ededed",
    "checkbox.disabled.foreground": "#8f8f8f", // colors.foreground_disable
    "checkbox.border": "#8f8f8f", // colors.border_strong
    "settings.checkboxBackground": "#0a0a0a", // colors.background_comparison
    "settings.checkboxForeground": "#ededed",
    "settings.checkboxBorder": "#8f8f8f", // colors.border_strong
    "input.background": "#0a0a0a", // colors.background_comparison
    "input.foreground": "#ededed",
    "input.placeholderForeground": "#7d7d7d", // colors.tertiary
    "input.border": "#1f1f1f",
    "dropdown.background": "#0a0a0a", // colors.background_comparison
    "dropdown.listBackground": "#0a0a0a", // colors.background_comparison
    "dropdown.border": "#1f1f1f",
    "dropdown.foreground": "#a1a1a1", // colors.secondary
    "list.hoverBackground": "#1a1a1a", // colors.background_hover
    "list.focusBackground": "#1a1a1a", // colors.background_hover
    "list.activeSelectionBackground": "#1f1f1f", // colors.background_active
    "list.inactiveFocusBackground": "#1a1a1a", // colors.background_hover
    "list.inactiveSelectionBackground": "#1f1f1f", // colors.background_active
    "list.hoverForeground": "#ededed",
    "list.focusForeground": "#ededed",
    "list.highlightForeground": "#ededed",
    "list.activeSelectionForeground": "#ededed",
    "list.inactiveSelectionForeground": "#ededed",
    "list.errorForeground": "#ff6166", // colors.red
    "list.warningForeground": "#f2a20d", // colors.amber

    // Peek View
    "peekView.border": "#1f1f1f",
    "peekViewTitle.background": "#0a0a0a", // colors.background_comparison
    "peekViewEditor.background": "#0a0a0a", // colors.background_comparison
    "peekViewResult.background": "#0a0a0a", // colors.background_comparison
    "peekViewEditor.matchHighlightBackground": "#331b00", // colors.background_match
    "peekViewResult.matchHighlightBackground": "#331b00", // colors.background_match

    // Default
    "foreground": "#a1a1a1", // colors.secondary
    "icon.foreground": "#a1a1a1", // colors.secondary
    "descriptionForeground": "#7d7d7d", // colors.tertiary
    "errorForeground": "#ff6166", // colors.red
    // Vercel use #000000 for all selection background,
    // and #000000 for all selection foreground,
    // but VSCode does not support foreground...
    // So we use the same color for select item background
    // for selection.
    "selection.background": "#1f1f1f", // colors.background_active
    "focusBorder": "#52a8ff", // colors.border_focus

    // Editor Group
    "editorGroup.border": "#1f1f1f",
    "editorGroupHeader.border": "#1f1f1f",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.tabsBorder": "#1f1f1f",

    // Editor Decorations
    // Line Number
    "editorLineNumber.foreground": "#a1a1a1", // colors.secondary
    "editorLineNumber.activeForeground": "#ededed",
    // Gutter
    "editorGutter.addedBackground": "#62c073", // colors.green
    "editorGutter.deletedBackground": "#ff6166", // colors.red
    "editorGutter.modifiedBackground": "#f2a20d", // colors.amber

    // Editor Widget
    "editorWidget.background": "#0a0a0a", // colors.background_comparison
    "editorWidget.border": "#1f1f1f",
    // Overview Ruler
    "editorOverviewRuler.errorForeground": "#ff6166", // colors.red
    "editorOverviewRuler.border": "#1f1f1f",
    // Minimap
    "minimap.selectionHighlight": "#1a1a1a", // colors.background_hover

    // Editor Content
    "editor.background": "#000000",
    "editor.foreground": "#ededed",
    // Line Highlight
    "editor.lineHighlightBackground": "#1a1a1a", // colors.background_hover
    // Word Highlight
    "editor.wordHighlightBackground": "#1a1a1a", // colors.background_hover
    "editor.wordHighlightBorder": "#00000000",
    "editor.wordHighlightStrongBackground": "#00000000",
    "editor.wordHighlightStrongBorder": "#00000000",
    // Bracket Match
    "editorBracketMatch.background": "#1a1a1a", // colors.background_hover
    "editorBracketMatch.border": "#00000000",
    // Selection
    "editor.selectionBackground": "#1a1a1a", // colors.background_hover
    "editor.inactiveSelectionBackground": "#1a1a1a", // colors.background_hover
    "editor.selectionHighlightBackground": "#1a1a1a", // colors.background_hover
    "editor.selectionHighlightBorder": "#1f1f1f", // colors.background_active (Visual + 1 level; no vercel.nvim source)
    // Find
    "editor.findMatchBackground": "#331b00", // colors.background_match
    "editor.findMatchHighlightBackground": "#331b00", // colors.background_match
    // Stack Frame
    "editor.stackFrameHighlightBackground": "#331b00", // colors.background_match
    "editor.focusedStackFrameHighlightBackground": "#1f1f1f",
    // Linked Editing
    "editor.linkedEditingBackground": "#1a1a1a", // colors.background_hover
    // Cursor
    "editorCursor.foreground": "#ededed",
    // Hover Widget
    "editorHoverWidget.background": "#0a0a0a", // colors.background_comparison
    "editorHoverWidget.foreground": "#a1a1a1", // colors.secondary
    // Ident Guide
    "editorIndentGuide.activeBackground1": "#1f1f1f", // colors.border
    "editorIndentGuide.background1": "#1f1f1f", // colors.border
    // Inlay Hint
    "editorInlayHint.background": "#000000",
    "editorInlayHint.foreground": "#7d7d7d", // colors.tertiary
    // Ruler
    "editorRuler.foreground": "#1f1f1f", // colors.border
    "editorWhitespace.foreground": "#7d7d7d", // colors.tertiary
    // Fold
    "editor.foldBackground": "#1a1a1a", // colors.background_hover

    // Error Lens
    "errorLens.errorBackground": "#561a1e", // colors.background_error
    "errorLens.errorBackgroundLight": "#561a1e", // colors.background_error
    "errorLens.errorForeground": "#ff6166", // colors.red
    "errorLens.errorForegroundLight": "#ff6166", // colors.red
    "errorLens.hintBackground": "#292929", // colors.background_verbose
    "errorLens.hintBackgroundLight": "#292929", // colors.background_verbose
    "errorLens.hintForeground": "#52a8ff", // colors.blue
    "errorLens.hintForegroundLight": "#52a8ff", // colors.blue
    "errorLens.infoBackground": "#0f2f57", // colors.background_info
    "errorLens.infoBackgroundLight": "#0f2f57", // colors.background_info
    "errorLens.infoForeground": "#52a8ff", // colors.blue
    "errorLens.infoForegroundLight": "#52a8ff", // colors.blue
    "errorLens.warningBackground": "#4d2a00", // colors.background_warning
    "errorLens.warningBackgroundLight": "#4d2a00", // colors.background_warning
    "errorLens.warningForeground": "#f2a20d", // colors.amber
    "errorLens.warningForegroundLight": "#f2a20d", // colors.amber

    // Git Decoration
    "gitDecoration.addedResourceForeground": "#62c073", // colors.green
    "gitDecoration.untrackedResourceForeground": "#62c073", // colors.green
    "gitDecoration.conflictingResourceForeground": "#f2a20d", // colors.amber
    "gitDecoration.modifiedResourceForeground": "#f2a20d", // colors.amber
    "gitDecoration.deletedResourceForeground": "#ff6166", // colors.red
    "gitDecoration.ignoredResourceForeground": "#a1a1a1", // colors.secondary
    "gitDecoration.submoduleResourceForeground": "#ededed",

    // Diff Editor
    "diffEditor.insertedTextBackground": "#12361b", // colors.background_diff_add
    "diffEditor.removedTextBackground": "#561a1e", // colors.background_diff_delete

    // Notification
    "notificationCenterHeader.background": "#0a0a0a", // colors.background_comparison
    "notificationCenterHeader.foreground": "#a1a1a1", // colors.secondary
    "notifications.background": "#0a0a0a", // colors.background_comparison
    "notifications.border": "#1f1f1f",
    "notifications.foreground": "#ededed",
    "notificationsInfoIcon.foreground": "#52a8ff", // colors.blue
    "notificationsWarningIcon.foreground": "#f2a20d", // colors.amber
    "notificationsErrorIcon.foreground": "#ff6166", // colors.red

    // Panel
    "panel.background": "#000000",
    "panel.border": "#1f1f1f",
    "panelTitle.inactiveForeground": "#a1a1a1", // colors.secondary
    "panelTitle.activeForeground": "#ededed",
    "panelTitle.activeBorder": "#52a8ff", // colors.border_focus
    "panelInput.border": "#1f1f1f",

    // Settings
    "settings.headerForeground": "#ededed",
    "settings.modifiedItemIndicator": "#ededed", // colors.foreground

    // Tab
    "tab.unfocusedHoverBackground": "#1a1a1a", // colors.background_hover
    "tab.hoverBackground": "#1a1a1a", // colors.background_hover
    "tab.inactiveBackground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveForeground": "#a1a1a1", // colors.secondary
    "tab.activeForeground": "#ededed",
    "tab.border": "#1f1f1f",
    "tab.unfocusedActiveBorder": "#000000", // colors.background
    "tab.unfocusedActiveBorderTop": "#000000", // colors.background
    "tab.activeBorder": "#000000", // colors.background
    "tab.activeBorderTop": "#52a8ff", // colors.border_focus

    // Terminal
    "terminal.foreground": "#ededed",
    "terminal.selectionBackground": "#1a1a1a", // colors.background_hover
    "terminal.ansiBlack": "#ededed", // colors.background_reverse
    "terminal.ansiBrightBlack": "#ededed", // colors.background_reverse
    "terminal.ansiBlue": "#52a8ff",
    "terminal.ansiBrightBlue": "#52a8ff",
    "terminal.ansiGreen": "#62c073",
    "terminal.ansiBrightGreen": "#62c073",
    "terminal.ansiCyan": "#0ac7b4", // colors.teal
    "terminal.ansiBrightCyan": "#0ac7b4", // colors.teal
    "terminal.ansiMagenta": "#bf7af0", // colors.purple
    "terminal.ansiBrightMagenta": "#bf7af0", // colors.purple
    "terminal.ansiRed": "#ff6166",
    "terminal.ansiBrightRed": "#ff6166",
    "terminal.ansiYellow": "#f2a20d", // colors.amber
    "terminal.ansiBrightYellow": "#f2a20d", // colors.amber
    "terminal.ansiWhite": "#0a0a0a", // colors.foreground_reverse
    "terminal.ansiBrightWhite": "#0a0a0a", // colors.foreground_reverse

    // Text
    "textBlockQuote.background": "#0a0a0a", // colors.background_comparison
    "textBlockQuote.border": "#ededed", // colors.foreground
    "textCodeBlock.background": "#0a0a0a", // colors.background_comparison
    "textLink.activeForeground": "#52a8ff", // colors.blue
    "textLink.foreground": "#52a8ff", // colors.blue
    "textPreformat.foreground": "#ededed",
    "textSeparator.foreground": "#a1a1a1", // colors.secondary
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#7d7d7d" // colors.tertiary
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language",
        "entity"
      ],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": [
        "entity.name",
        "meta.export.default",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": [
        "variable.parameter.function",
        "meta.jsx.children",
        "meta.block",
        "meta.tag.attributes",
        "entity.name.constant",
        "meta.object.member",
        "meta.embedded.expression",
        "meta.template.expression",
        "string.other.begin.yaml",
        "string.other.end.yaml"
      ],
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": ["entity.name.function", "support.type.primitive"],
      "settings": {
        "foreground": "#bf7af0" // colors.purple
      }
    },
    {
      "scope": ["support.class.component"],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.separator.key-value.css",
        "entity.name.tag.yaml",
        "punctuation.separator.key-value.mapping.yaml"
      ],
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#62c073" // colors.green
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": [
        "support.type.object.module",
        "variable.other.object",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "foreground": "#7d7d7d" // colors.tertiary
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#ff6166" // colors.red
      }
    },
    {
      "scope": "string source",
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#f2a20d" // colors.amber
      }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#f2a20d" // colors.amber
      }
    },
    {
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": {
        "foreground": "#7d7d7d" // colors.tertiary
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#bf7af0" // colors.purple
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "meta.export.default",
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#ededed" // colors.foreground
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#f75f8f" // colors.pink
      }
    },
    {
      "scope": ["constant.other.reference.link", "string.other.link"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#52a8ff" // colors.blue
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#f2a20d" // colors.amber
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ff6166" // colors.red
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#bf7af0" // colors.purple
      }
    }
  ],
  "type": "dark"
}
