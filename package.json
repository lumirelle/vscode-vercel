{
  "name": "vscode-vercel-theme",
  "displayName": "VSCode Vercel Theme",
  "description": "A carefully crafted set of colorschemes that are faithful to Next.js & Vercel's docs",
  "publisher": "lumirelle",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lumirelle/vscode-vercel.git"
  },
  "bugs": {
    "url": "https://github.com/lumirelle/vscode-vercel/issues",
    "email": "lumirelle@outlook.com"
  },
  "keywords": [
    "theme",
    "vercel",
    "dark",
    "light",
    "italics"
  ],
  "icon": "assets/icon.png",
  "contributes": {
    "themes": [
      {
        "label": "Vercel (Light)",
        "uiTheme": "vs",
        "path": "./themes/vercel-light.json"
      },
      {
        "label": "Vercel (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/vercel-dark.json"
      }
    ]
  },
  "packageManager": "nub@0.7.1",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.1",
      "onFail": "ignore"
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  },
  "allowBuilds": {
    "@vscode/vsce-sign": true,
    "keytar": true
  }
}
